#compdef sranime-cli

_sranime_cli() {
    local -a qualities providers formats logins
    qualities=(
        'best:Highest available quality'
        'worst:Lowest available quality'
        '1080p:1080p Full HD'
        '720p:720p HD'
        '480p:480p SD'
        '360p:360p Low'
    )
    providers=(
        'hianime:HiAnime / Zoro extraction engine (primary default)'
        'allanime:AllAnime GraphQL API engine (backup)'
        'gogo:GogoAnime / Anitaku scraper (backup)'
    )
    formats=(
        'json:Export structured JSON'
        'csv:Export comma-separated values'
    )
    logins=(
        'anilist:AniList cloud tracker'
        'mal:MyAnimeList cloud tracker'
    )

    _arguments -s -S \
        '--skip-filler[Automatically skip filler episodes during autoplay]' \
        '--canon-only[Filter out non-canon filler episodes from picker]' \
        '--show-filler[Display canon/filler status badges in episode list]' \
        '(--dashboard --tui)'{--dashboard,--tui}'[Launch interactive Anime Bento dashboard]' \
        '--manga[Launch Manga Hub to search and read manga]:query:' \
        '(-c --chapter)'{-c,--chapter}'[Jump directly to specified manga chapter]:chapter:' \
        '(-md --manga-download)'{-md,--manga-download}'[Download manga chapter as CBZ]' \
        '--manga-lang[Preferred manga language]:language:(en ja es fr de it pt)' \
        '(-t --theme)'{-t,--theme}'[Search and stream anime Opening & Ending themes]:query:' \
        '--theme-type[Filter theme songs by type]:type:(all op ed)' \
        '(-ao --audio-only)'{-ao,--audio-only}'[Stream theme audio only]' \
        '--theme-download[Download selected theme song video/audio]' \
        '--notify-airing[Check for upcoming simulcasts and notify]:hours:' \
        '--airing-window[Lookahead window in hours for airing alerts]:hours:' \
        '(-O --offline)'{-O,--offline}'[Browse and play downloaded anime from local vault]' \
        '--local[Specify local vault directory for offline playback]:directory:_files -/' \
        '--color-theme[Set UI color palette]:theme:(catppuccin dracula nord gruvbox tokyo-night cyberpunk default)' \
        '--color-themes[Display visual gallery of all color theme palettes]' \
        '(-c --continue)'{-c,--continue}'[Continue watching from history]' \
        '(-A --autoplay)'{-A,--autoplay}'[Automatically play subsequent episodes continuously]' \
        '--autoplay-limit[Limit number of consecutive autoplay episodes]:count:' \
        '(-R --resume)'{-R,--resume}'[Resume playback from saved timestamp checkpoint]' \
        '--start-time[Seek to exact timestamp on playback start]:time (MM:SS):' \
        '--show-checkpoints[Display active in-progress watch checkpoints]' \
        '--clear-checkpoints[Clear all stored playback timestamp checkpoints]' \
        '--seasonal[Browse popular anime from broadcast season]:season:' \
        '--trending[Browse currently trending anime series]' \
        '(--calendar --schedule)'{--calendar,--schedule}'[Display upcoming airing schedule with countdowns]' \
        '--similar[Find and stream recommendations based on title]:anime title:' \
        '(-d --download)'{-d,--download}'[Download the video instead of playing it]' \
        '--download-dir[Directory for downloaded anime]:directory:_files -/' \
        '--show-history[Display watch history and exit]' \
        '(-D --delete --clear-history)'{-D,--delete,--clear-history}'[Delete history]' \
        '(-l --logview)'{-l,--logview}'[Show logs]' \
        '(-s --syncplay)'{-s,--syncplay}'[Use Syncplay to watch with friends]' \
        '--room[Set Syncplay room name]:room name:' \
        '--discord[Enable Discord Rich Presence]' \
        '--no-discord[Disable Discord Rich Presence]' \
        '(-S --select-nth)'{-S,--select-nth}'[Select nth entry]:index:' \
        '(-p --provider)'{-p,--provider}'[Specify stream provider]:provider:(($providers))' \
        '--list-providers[List available stream providers]' \
        '(-q --quality)'{-q,--quality}'[Specify the video quality]:quality:(($qualities))' \
        '(-v --vlc)'{-v,--vlc}'[Use VLC to play the video]' \
        '(-V --version)'{-V,--version}'[Show the version of the script]' \
        '(-h --help)'{-h,--help}'[Show help message and exit]' \
        '(-e --episode -r --range)'{-e,--episode,-r,--range}'[Specify the number of episodes to watch]:episode:' \
        '--dub[Play dubbed version]' \
        '--rofi[Use rofi instead of fzf for the interactive menu]' \
        '--dmenu[Use dmenu instead of fzf for the interactive menu]' \
        '--skip[Use ani-skip to skip the intro of the episode (mpv only)]' \
        '--no-detach[Do not detach the player]' \
        '--exit-after-play[Exit the player and return the exit code]' \
        '(-N --nextep-countdown)'{-N,--nextep-countdown}'[Display a countdown to the next episode]' \
        '(-U --update)'{-U,--update}'[Update the script]' \
        '--edit-config[Open user configuration file in default editor]' \
        '--validate-config[Validate configuration file syntax]' \
        '--dump-config[Print active configuration values and exit]' \
        '--watchlist[Display the saved anime watchlist]' \
        '--watchlist-clear[Clear the watchlist]' \
        '(-W --watch-log)'{-W,--watch-log}'[Display lifetime watch log history]:filter:' \
        '--watch-stats[Display viewing statistics and analytics]' \
        '--watch-export[Export watch log to JSON or CSV]:format:(($formats))' \
        '--clear-watch-log[Clear the lifetime watch log]' \
        '--no-preview[Disable the rich terminal preview pane in fzf]' \
        '--login[Authenticate with cloud tracking service]:service:(($logins))' \
        '--logout[Log out from cloud tracking service]:service:(($logins))' \
        '--export-mal[Export watch log in MyAnimeList XML format]:file:_files' \
        '--import-mal[Import watch history from MyAnimeList XML file]:file:_files' \
        '--nfo[Generate Jellyfin/Plex/Kodi .nfo metadata and download artwork]' \
        '--save-subs[Extract and save external subtitle sidecars (.vtt/.srt)]' \
        '--queue[Enqueue episode for background downloading]' \
        '--queue-status[Display background download queue status]' \
        '--queue-start[Start background download queue daemon worker]' \
        '--queue-pause[Pause background download queue]' \
        '--queue-resume[Resume background download queue]' \
        '--queue-clear[Clear items from download queue]:mode:(all completed)' \
        '--scrobble-status[Display status of linked tracking accounts]' \
        '--sync[Open interactive selection menu with AniList Currently Watching]' \
        '--sync-list[Display AniList Currently Watching list and exit]' \
        '--no-scrobble[Disable automatic episode tracking for this session]' \
        '--doctor[Run system diagnostics and dependency check]' \
        '*:query:'
}

_sranime_cli "$@"
