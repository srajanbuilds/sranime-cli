# bash completion for sranime-cli

_sranime_cli() {
    local cur prev opts qualities providers formats logins
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="-c --continue -A --autoplay --autoplay-limit -R --resume --start-time --show-checkpoints --seasonal --trending --calendar --schedule --similar --clear-checkpoints -d --download -D --delete --clear-history --show-history -l --logview -s --syncplay --room -S --select-nth -p --provider --list-providers -q --quality -v --vlc -V --version -h --help -e --episode -r --range --dub --rofi --dmenu --skip --no-detach --exit-after-play -N --nextep-countdown -U --update --edit-config --validate-config --dump-config --watchlist --watchlist-clear -W --watch-log --watch-stats --watch-export --clear-watch-log --no-preview --sync --sync-list --no-scrobble --login --logout --export-mal --import-mal --nfo --save-subs --queue --queue-status --queue-start --queue-pause --queue-resume --queue-clear --scrobble-status --discord --no-discord --download-dir --doctor"
    qualities="best worst 360p 480p 720p 1080p"
    providers="hianime allanime gogo"
    formats="json csv"
    logins="anilist mal"

    case "$prev" in
        -q|--quality)
            COMPREPLY=( $(compgen -W "${qualities}" -- "$cur") )
            return 0
            ;;
        -p|--provider)
            COMPREPLY=( $(compgen -W "${providers}" -- "$cur") )
            return 0
            ;;
        --watch-export)
            COMPREPLY=( $(compgen -W "${formats}" -- "$cur") )
            return 0
            ;;
        --login|--logout)
            COMPREPLY=( $(compgen -W "${logins}" -- "$cur") )
            return 0
            ;;
        --download-dir|--export-mal|--import-mal)
            COMPREPLY=( $(compgen -f -- "$cur") )
            return 0
            ;;
        --queue-clear)
            COMPREPLY=( $(compgen -W "completed all" -- "$cur") )
            return 0
            ;;
        -S|--select-nth|-e|--episode|-r|--range|--room|-A|--autoplay|--autoplay-limit|-R|--resume|--start-time|--similar|--seasonal)
            return 0
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- "$cur") )
        return 0
    fi
}

complete -F _sranime_cli sranime-cli
